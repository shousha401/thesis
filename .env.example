# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored and must never be committed.
# In production these are set in the Vercel dashboard, not in a file.
# ---------------------------------------------------------------------------

# From Supabase dashboard -> Project Settings -> API.
# Both are safe to expose in the browser: the anon key only ever gets the
# access that Row Level Security allows it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The canonical public origin, no trailing slash. Used for canonical URLs,
# sitemap.xml, OpenGraph image URLs and JSON-LD.
# Local development can leave this unset; it defaults to http://localhost:3000.
# In production set it to the real domain, e.g. https://shesgotathesis.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NOT USED, and deliberately so:
#
# There is no SUPABASE_SERVICE_ROLE_KEY anywhere in this project. The service
# role key bypasses Row Level Security entirely, so a single mistake with it
# exposes or destroys everything. The admin dashboard instead acts as the
# signed-in user and is authorised by the RLS policies, which means the
# database enforces access control even if the application has a bug.
#
# If you ever find yourself adding it, that is a sign something should be
# fixed in the policies instead.
# ---------------------------------------------------------------------------
